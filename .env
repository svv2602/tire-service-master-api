# ==============================================
# TIRE SERVICE API - ENVIRONMENT VARIABLES
# ==============================================
API_HOST=localhost
DOCKER_ENV=false
API_PORT=8000
# ==============================================
# RAILS SETTINGS
# ==============================================
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_LEVEL=debug
# Environment
RACK_ENV=development

# ==============================================
# DATABASE SETTINGS
# ==============================================
DATABASE_URL=postgresql://snisar:snisar@localhost:5433/tire_service_dev_new
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tire_service_dev_new
DB_USER=snisar
DB_PASSWORD=snisar

# ==============================================
# REDIS SETTINGS
# ==============================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================
# SECURITY SETTINGS
# ==============================================
# ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ В PRODUCTION!
SECRET_KEY_BASE=development_secret_key_base_change_in_production
JWT_SECRET=development_jwt_secret_change_in_production

# ==============================================
# CORS SETTINGS
# ==============================================
ALLOWED_ORIGINS=http://localhost:3008,http://127.0.0.1:3008,http://192.168.3.145:3008

