<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #1976d2;
      color: white;
      padding: 15px;
      text-align: center;
      border-radius: 5px 5px 0 0;
    }
    .content {
      padding: 20px;
      background-color: #f9f9f9;
      border: 1px solid #ddd;
    }
    .booking-details {
      background-color: white;
      padding: 15px;
      margin: 20px 0;
      border-radius: 5px;
      border: 1px solid #eee;
    }
    .detail-row {
      display: flex;
      margin: 10px 0;
    }
    .detail-label {
      width: 120px;
      font-weight: bold;
    }
    .footer {
      text-align: center;
      font-size: 12px;
      color: #777;
      margin-top: 20px;
    }
    .button {
      display: inline-block;
      background-color: #1976d2;
      color: white;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 5px;
      margin-top: 15px;
    }
    .notice {
      background-color: #fff3e0;
      padding: 10px;
      border-radius: 5px;
      margin-top: 15px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= t('mailers.booking.created.title') %></h1>
    </div>
    
    <div class="content">
      <p><%= t('mailers.common.greeting', name: @booking.client.full_name) %></p>
      
      <p><%= t('mailers.booking.created.success_message') %></p>
      
      <div class="booking-details">
        <div class="detail-row">
          <div class="detail-label"><%= t('mailers.booking.details.date') %>:</div>
          <div><%= l(@booking.start_time.to_date, format: :long) %></div>
        </div>
        
        <div class="detail-row">
          <div class="detail-label"><%= t('mailers.booking.details.time') %>:</div>
          <div><%= l(@booking.start_time, format: :time) %></div>
        </div>
        
        <div class="detail-row">
          <div class="detail-label"><%= t('mailers.booking.details.service') %>:</div>
          <div><%= @booking.service.name %></div>
        </div>
        
        <div class="detail-row">
          <div class="detail-label"><%= t('mailers.booking.details.address') %>:</div>
          <div><%= @booking.service_point.full_address %></div>
        </div>
        
        <div class="detail-row">
          <div class="detail-label"><%= t('mailers.booking.details.car') %>:</div>
          <div>
            <%= t('mailers.booking.details.car_format',
                  brand: @booking.car.car_brand.name,
                  model: @booking.car.car_model.name,
                  license_plate: @booking.car.license_plate) %>
          </div>
        </div>
      </div>
      
      <div class="notice">
        <p><%= t('mailers.booking.notices.arrive_early') %></p>
        <p><%= t('mailers.booking.notices.cancellation') %></p>
      </div>
      
      <div style="text-align: center; margin-top: 20px;">
        <a href="<%= @booking_url %>" class="button">
          <%= t('mailers.booking.actions.view_booking') %>
        </a>
      </div>
    </div>
    
    <div class="footer">
      <p><%= t('mailers.common.footer.copyright', year: Date.current.year) %></p>
      <p><%= t('mailers.common.footer.auto_message') %></p>
    </div>
  </div>
</body>
</html> 