<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background-color: #1976d2;
      color: white;
      padding: 15px;
      text-align: center;
      border-radius: 5px 5px 0 0;
    }
    .content {
      padding: 20px;
      background-color: #f9f9f9;
      border: 1px solid #ddd;
    }
    .reset-details {
      background-color: white;
      padding: 15px;
      margin: 20px 0;
      border-radius: 5px;
      border: 1px solid #eee;
    }
    .footer {
      text-align: center;
      font-size: 12px;
      color: #777;
      margin-top: 20px;
    }
    .button {
      display: inline-block;
      background-color: #1976d2;
      color: white;
      padding: 10px 20px;
      text-decoration: none;
      border-radius: 5px;
      margin-top: 15px;
    }
    .warning {
      color: #e53935;
      font-size: 12px;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= t('mailers.password_reset.title') %></h1>
    </div>
    
    <div class="content">
      <p><%= t('mailers.common.greeting', name: '') %></p>
      
      <p><%= t('mailers.password_reset.instructions') %></p>
      
      <div class="reset-details">
        <p><%= t('mailers.password_reset.reset_button') %>:</p>
        
        <div style="text-align: center;">
          <a href="<%= @reset_url %>" class="button"><%= t('mailers.password_reset.reset_button') %></a>
        </div>
        
        <p class="warning"><%= t('mailers.password_reset.expiry_notice') %></p>
      </div>
      
      <p><%= t('mailers.password_reset.ignore_notice') %></p>
      
      <p>
        <%= t('mailers.password_reset.regards') %><br>
        <%= t('mailers.password_reset.team') %>
      </p>
    </div>
    
    <div class="footer">
      <p><%= t('mailers.common.footer.copyright', year: Date.current.year) %></p>
      <p><%= t('mailers.common.footer.auto_message') %></p>
    </div>
  </div>
</body>
</html> 