<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background-color: #d32f2f; color: white; padding: 15px 20px; border-radius: 4px 4px 0 0; }
    .content { background-color: #f5f5f5; padding: 20px; border: 1px solid #ddd; border-top: none; border-radius: 0 0 4px 4px; }
    .message { white-space: pre-wrap; font-family: monospace; background: white; padding: 15px; border-radius: 4px; border: 1px solid #e0e0e0; }
    .footer { margin-top: 20px; font-size: 12px; color: #999; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Admin Alert - Tire Service</h2>
    </div>
    <div class="content">
      <div class="message"><%= @body %></div>
      <div class="footer">
        <p>Sent at: <%= @timestamp.strftime('%Y-%m-%d %H:%M:%S %Z') %></p>
        <p>This is an automated notification from Tire Service platform.</p>
      </div>
    </div>
  </div>
</body>
</html>
